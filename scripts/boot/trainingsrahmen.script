# Plymouth-Theme des Trainingsrahmens: Boot-Screen 5B (P.M.-Monogramm + 3 Punkte) bildschirmfüllend.
# Die Punkte laufen reihum: splash-1 → splash-2 → splash-3, je 0,5 s.

Window.SetBackgroundTopColor(0.067, 0.067, 0.067);
Window.SetBackgroundBottomColor(0.067, 0.067, 0.067);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# Gezeichnet für 800 × 480 (Waveshare 7"); andere Auflösungen werden gestreckt.
frames[1] = Image("splash-1.png").Scale(screen_w, screen_h);
frames[2] = Image("splash-2.png").Scale(screen_w, screen_h);
frames[3] = Image("splash-3.png").Scale(screen_w, screen_h);
background = Sprite(frames[1]);
background.SetZ(-10);

tick = 0;
fun refresh_callback() {
  # Plymouth ruft das 50-mal pro Sekunde auf: 25 Aufrufe = 0,5 s pro Bild.
  tick = tick + 1;
  if (tick >= 75) tick = 0;
  background.SetImage(frames[Math.Int(tick / 25) + 1]);
}
Plymouth.SetRefreshFunction(refresh_callback);
