# Daemon (Node): Display, Portal, Admin, Sync. @USER@, @DIR@ und @NODE@ setzt scripts/install-services.sh ein.
# Logs: journalctl -u trainingsrahmen -f
# Demo-Modus und andere Schalter (FRAME_DEMO=1, FRAME_PIR_PIN=…) stehen in data/frame.env, siehe scripts/demo.sh.

[Unit]
Description=Trainingsrahmen Daemon
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
# Portal zusätzlich auf Port 80, damit Handys im Hotspot http://10.42.0.1/setup ohne Port öffnen.
Environment=FRAME_PORTAL_PORT=80
EnvironmentFile=-@DIR@/data/frame.env
ExecStart=@NODE@ @DIR@/daemon/server.js
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
