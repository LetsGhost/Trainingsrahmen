# Startet scripts/self-update.sh unabhängig vom Daemon, damit dessen Neustart das Update nicht abbricht.
# Der Daemon startet die Unit mit „systemctl start --no-block trainingsrahmen-update.service“; das darf der
# User laut scripts/system/trainingsrahmen.rules (polkit). @USER@ und @DIR@ setzt scripts/install-services.sh ein.
# Logs: journalctl -u trainingsrahmen-update

[Unit]
Description=Trainingsrahmen Update per Knopf

[Service]
Type=oneshot
# Gleicher User wie der Daemon, damit git keine Dateien als root anlegt.
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=-@DIR@/data/update.env
ExecStart=@DIR@/scripts/self-update.sh
