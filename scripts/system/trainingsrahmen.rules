// polkit: Erlaubt dem Rahmen-User (@USER@) ohne Passwort
//   - WLAN über NetworkManager (daemon/system/pi.js),
//   - die eigenen Units starten, neu starten und stoppen (Hotspot, Update-Knopf, self-update.sh, demo.sh, factory-reset.sh),
//   - den Pi neu starten und herunterfahren (Knöpfe im Admin-Bereich).
// Installiert scripts/install-services.sh nach /etc/polkit-1/rules.d/50-trainingsrahmen.rules.
polkit.addRule(function (action, subject) {
  if (subject.user !== "@USER@") return polkit.Result.NOT_HANDLED;
  if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0) return polkit.Result.YES;
  if (/^org.freedesktop.login1.(reboot|power-off)(-multiple-sessions|-ignore-inhibit)?$/.test(action.id)) return polkit.Result.YES;
  if (action.id === "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var units = ["trainingsrahmen.service", "trainingsrahmen-kiosk.service", "trainingsrahmen-update.service", "trainingsrahmen-hotspot.service"];
    if (units.indexOf(unit) >= 0 && ["start", "stop", "restart"].indexOf(verb) >= 0) return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
